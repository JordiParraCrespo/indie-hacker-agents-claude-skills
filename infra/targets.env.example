# Copy to infra/targets.env and fill in. That file is git-ignored.
#
# Targets are named rather than passed as raw IPs so that irreversible actions
# can refuse to run against prod without a human typing the word out loud.

# Tailscale MagicDNS names. Admin access is tailnet-only — these should NOT be
# public hostnames, and after the SSH cutover they are the only way in.
STAGING_HOST=staging-app
PROD_HOST=prod-app

# Public IPs, used only by verify.sh for the external port scan. That scan is
# the single most valuable check in the whole setup: it is the difference
# between "ufw says we are closed" and "the internet agrees".
STAGING_PUBLIC_IP=
PROD_PUBLIC_IP=

# Public hostnames served through the tunnel, for the end-to-end check.
STAGING_TUNNEL_HOSTNAME=staging.example.com
PROD_TUNNEL_HOSTNAME=api.example.com

# Where the stack lives on the server.
REMOTE_DIR=/srv/app

# --- backups ---------------------------------------------------------------
R2_BUCKET=
B2_BUCKET=

# age PUBLIC key (age1...). Not sensitive — it only encrypts.
# The PRIVATE key never appears here, on the server, or anywhere in this repo.
# It is escrowed offline and supplied to the restore drill at run time.
AGE_RECIPIENT=
